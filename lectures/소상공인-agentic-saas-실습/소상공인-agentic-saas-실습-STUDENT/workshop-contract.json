			"status": "published",
			"tag": "v0.1.0",
			"commit": "68ead8a8e93e08001bf04dfb705d8fcd3c844ca5",
			"url": "https://github.com/NewTurn2017/jeomwon/releases/tag/v0.1.0",
			"asset": {
				"name": "jeomwon-template-v0.1.0.tar.gz",
				"url": "https://github.com/NewTurn2017/jeomwon/releases/download/v0.1.0/jeomwon-template-v0.1.0.tar.gz",
				"sha256": "fe74258da1c56e4811e5c9665aab5e940dd200fe2e6c5d6b13c39a64c95aa282"
			}
		},
		"localCheckout": {
			"developmentOnly": true
		},
		"skillSource": {
			"kind": "published-release-asset",
			"tag": "v0.1.0",
			"archiveSha256": "fe74258da1c56e4811e5c9665aab5e940dd200fe2e6c5d6b13c39a64c95aa282",
			"contentSha256": "813c37e8f4626af3945c8f1af6bddc8ead0a60a9c2340936fd2b123bb584a3a7"
		}
	},
	"commands": {
		"workingDirectory": "repository-root",
		"skillDirectory": "$HOME/.claude/skills/jeomwon",
		"packPath": "lectures/소상공인-agentic-saas-실습/assets/student/salon-domain-pack.json",
		"install": [
			"bunx",
			"--bun",
			"skills@1.5.22",
			"add",
			"https://github.com/NewTurn2017/jeomwon/tree/v0.1.0/skill",
			"--skill",
			"jeomwon",
			"--agent",
			"universal",
			"claude-code",
			"--global",
			"--yes"
		],
		"preflight": [
			"bun",
			"${CLAUDE_SKILL_DIR}/scripts/preflight.mjs",
			"${TARGET}",
			"Workshop Salon",
			"${PACK}"
		],
		"bootstrap": [
			"bun",
			"${CLAUDE_SKILL_DIR}/scripts/bootstrap.mjs",
			"${TARGET}",
			"Workshop Salon",
			"${PACK}"
		]
	},
	"expectedMarkers": ["PREFLIGHT PASS", "[SKIP verify_qa]", "VERIFY PASS"],
	"offline": {
		"networkAllowed": false,
		"stages": [
			"install",
			"typecheck",
			"lint",
			"test",
			"build_email",
			"build_app",
			"build_web"
		]
	},
	"live": {
		"includedInBootstrap": false,
		"requiredSetup": [
			"Convex dev deployment",
			"Google OAuth credentials",
			"authenticated customer",
			"authenticated operator"
		]
	},
	"fallback": {
		"kind": "facilitator-pre-generated-target",
		"environmentVariable": "JEOMWON_WORKSHOP_FALLBACK",
		"requiredFiles": [
			"jeomwon-project.json",
			"domain-pack.json",
			"packages/backend/domain.config.ts"
		],
		"liveClaimAllowed": false
	},
	"demo": {
		"slide": 2,
		"kind": "pre-provisioned-real-app",
		"status": "blocked",
		"reasonCode": "provider_authorization_absent",
		"credentialsProvisionedByBootstrap": false,
		"surfaces": [
			"customer calendar",
			"customer reservation",
			"operator dashboard",
			"same-slot collision"
		]
	}
