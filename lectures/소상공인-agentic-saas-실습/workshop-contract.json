{
	"schemaVersion": 2,
	"toolchain": {
		"bun": "1.3.14",
		"skillsCli": "1.5.22",
		"hosts": {
			"claude": {
				"primary": true,
				"install": "curl -fsSL https://claude.ai/install.sh | bash",
				"launch": "claude"
			},
			"codex": {
				"primary": false,
				"install": "curl -fsSL https://chatgpt.com/codex/install.sh | sh",
				"launch": "codex"
			}
		}
	},
	"distribution": {
		"release": {
			"tag": "v0.1.3",
			"skillVersion": "0.1.3",
			"templateVersion": "0.1.3",
			"status": "published",
			"url": "https://github.com/NewTurn2017/jeomwon/releases/tag/v0.1.3",
			"asset": {
				"name": "jeomwon-template-v0.1.3.tar.gz",
				"url": "https://github.com/NewTurn2017/jeomwon/releases/download/v0.1.3/jeomwon-template-v0.1.3.tar.gz",
				"sha256": "41ac8c763e57391f5faa29dae72c9bc80e219c9e35213fc3a9b8d48c607d1886"
			}
		},
		"installer": {
			"url": "https://github.com/NewTurn2017/jeomwon/releases/download/v0.1.3/install.sh",
			"sourcePath": "install.sh"
		},
		"skillInstallCommand": "curl -fsSL https://github.com/NewTurn2017/jeomwon/releases/download/v0.1.3/install.sh | bash -s -- --agent all",
		"skillSource": {
			"kind": "release-asset",
			"tag": "v0.1.3",
			"archiveName": "jeomwon-template-v0.1.3.tar.gz",
			"archiveSha256": "41ac8c763e57391f5faa29dae72c9bc80e219c9e35213fc3a9b8d48c607d1886",
			"contentSha256": "89cb17caa933c622aacb24b385dd952fa7f49e8cf5b84b872c515beac799a1ae",
			"installArguments": [
				"bun",
				"x",
				"skills@1.5.22",
				"add",
				"https://github.com/NewTurn2017/jeomwon/tree/v0.1.3/skill",
				"--skill",
				"jeomwon",
				"--agent",
				"universal",
				"claude-code",
				"codex",
				"--global",
				"--yes"
			]
		},
		"localCheckout": {
			"developmentOnly": true,
			"note": "Release publication 전 강사 리허설에서만 현재 checkout을 사용한다."
		}
	},
	"commands": {
		"workingDirectory": "empty-workspace",
		"workspace": "$HOME/Desktop/jeomwon-zero-test",
		"skillRoot": "${JEOMWON_SKILL_DIR:-${CLAUDE_SKILL_DIR:-$HOME/.agents/skills/jeomwon}}",
		"warmCache": [
			"bun",
			"${JEOMWON_SKILL_DIR:-${CLAUDE_SKILL_DIR:-$HOME/.agents/skills/jeomwon}}/scripts/warm-cache.mjs",
			"--lang",
			"ko"
		],
		"convexLogin": [
			"bun",
			"x",
			"convex",
			"login"
		],
		"setup": [
			"bun",
			"setup",
			"--lang",
			"ko"
		],
		"qa": [
			"bun",
			"run",
			"qa"
		],
		"dev": [
			"bun",
			"dev"
		]
	},
	"journey": {
		"existingDomainPackAllowed": false,
		"packCreatedBy": "jeomwon-interview",
		"outputPack": "domain-pack.json",
		"targetRule": "domain-pack.json은 workspace에, 생성 target은 absent child directory에 둔다.",
		"approvalToken": "확정",
		"stages": [
			"create-empty-directory",
			"install-host-cli",
			"authenticate-host",
			"install-jeomwon-skill",
			"launch-host",
			"interview",
			"approve-domain-pack",
			"bootstrap",
			"convex-login",
			"google-oauth",
			"bun-setup",
			"live-qa",
			"manual-smoke"
		]
	},
	"expectedMarkers": [
		"INSTALL PASS jeomwon v0.1.3",
		"PREFLIGHT PASS",
		"[SKIP verify_qa]",
		"VERIFY PASS"
	],
	"offline": {
		"stages": [
			"install",
			"typecheck",
			"lint",
			"test",
			"build_email",
			"build_app",
			"build_web"
		],
		"setupIncluded": false,
		"liveQaIncluded": false,
		"networkAllowedAfterPreflight": false
	},
	"live": {
		"includedInBootstrap": false,
		"startsAfter": [
      "bunx convex login",
			"bun setup --lang ko"
		],
		"qaCommand": "bun run qa",
		"manualSmoke": [
			"customer reservation",
			"second-profile collision rejection",
			"allowlisted Google operator access",
			"non-allowlisted Google operator denial",
			"Convex persistence after refresh"
		],
		"devOnly": true
	},
	"fallback": {
		"kind": "facilitator-pre-generated-target",
		"teachingSuccess": false,
		"requiredFiles": [
			"jeomwon-project.json",
			"jeomwon-capabilities.json",
			"qa-artifacts/verification.json"
		]
	},
	"demo": {
		"slide": 2,
		"kind": "pre-provisioned-real-app",
		"credentialsProvisionedByBootstrap": false,
		"fallbackArtifacts": {
			"receipt": "jeomwon-project.json",
			"verification": "qa-artifacts/verification.json",
			"capabilities": "jeomwon-capabilities.json"
		}
	},
	"quickStart": {
		"mac": "RUN-WORKSHOP-Mac.command",
		"windows": "RUN-WORKSHOP-Windows.bat",
		"primaryHost": "claude-code",
		"compatibleHosts": [
			"claude-code",
			"codex"
		],
		"steps": [
			"create-empty-directory",
			"install-skill",
			"launch-interview"
		],
		"networkRequiredForInstall": true
	}
}
