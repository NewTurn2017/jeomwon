# Site
SITE_URL=http://localhost:3000

# Optional product anonymous login for the authenticated customer app. Enabled
# only when this is exactly `1` and JEOMWON_ADMIN_EMAILS is configured.
AUTH_ANONYMOUS_LOGIN=

# Optional Polar billing. Required only when domain.config features.polar=true.
# Set these as Convex env vars via setup or convex env set before using Polar.
POLAR_ORGANIZATION_TOKEN=
POLAR_WEBHOOK_SECRET=

# Optional one-time Polar product charged as a per-reservation deposit. Leave
# empty to keep deposits off; billing still works with subscriptions only.
POLAR_DEPOSIT_PRODUCT_ID=
